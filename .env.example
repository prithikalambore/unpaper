# Public domain name pointing at this server (DNS A/AAAA record). Caddy gets the HTTPS certificate.
DOMAIN=pdf2word.example.com
# Email for Let's Encrypt expiry notices (optional but recommended).
ACME_EMAIL=you@example.com

# Limits (defaults shown)
MAX_UPLOAD_MB=25
MAX_REQUEST_MB=26
MAX_PAGES=300
CONVERSION_TIMEOUT_SECONDS=180
MAX_CONCURRENT_JOBS=2
RATE_LIMIT_PER_HOUR=20
RATE_LIMIT_PER_DAY=60
MAX_ACTIVE_JOBS_PER_CLIENT=1

# Backend container resources: size to the server (2 CPUs / 4 GB RAM server -> 2 / 2g)
BACKEND_CPUS=2
BACKEND_MEMORY=2g
